# Copy this file to `secrets.env` in the same directory and fill in the value.
# `secrets.env` and `tokens.json` are gitignored — never commit either one.
#
# Get the Client ID from https://developer.spotify.com/dashboard
#   -> your app -> Settings -> Basic Information

SPOTIFY_CLIENT_ID=YOUR_CLIENT_ID_HERE

# Must match a Redirect URI registered in the dashboard byte-for-byte,
# including the trailing path. Spotify rejects `localhost` — use the IP literal.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# No client secret is needed. This script uses Authorization Code + PKCE,
# which is the correct flow for a device whose firmware can be dumped.
